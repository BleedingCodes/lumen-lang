fn fib(n) {
    if (n < 2) {
        return n;
    }

    return fib(n - 1) + fib(n - 2);
}

fn make_counter(start) {
    let value = start;

    fn next() {
        value = value + 1;
        return value;
    }

    return next;
}

let counter = make_counter(40);
print("counter:", counter(), counter());
print("fib(10):", fib(10));

let values = [2, 3, 5, 7, 11];
print("third prime:", values[2]);

let person = {"name": "Ada", "field": "computing"};
print(person["name"], person["field"]);
